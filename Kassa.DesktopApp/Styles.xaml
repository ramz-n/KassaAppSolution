<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="KassaButton" TargetType="Button">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="#2C6E49" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#A9A9A9" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3A8461" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="KassaButtonDanger" TargetType="Button" BasedOn="{StaticResource KassaButton}">
        <Setter Property="Background" Value="#B3261E" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#D3413A" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="KassaButtonSecondary" TargetType="Button" BasedOn="{StaticResource KassaButton}">
        <Setter Property="Background" Value="#455A64" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#5C7580" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="KassaTextBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="KassaPasswordBox" TargetType="PasswordBox">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="KassaComboBox" TargetType="ComboBox">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Column Header Style -->
    <Style x:Key="KassaColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="48"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="#E2E8F0"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <!-- Grid Cell Style -->
    <Style x:Key="KassaCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            Background="{TemplateBinding Background}" 
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Action Button Style -->
    <Style x:Key="KassaRemoveButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Background" Value="#FEE2E2"/>
        <Setter Property="Foreground" Value="#DC2626"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Basic control template override to keep the button flat and modern on touch -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="4" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
