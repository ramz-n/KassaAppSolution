<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Kassa.DesktopApp.Views.ProductView"
             >

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,24,20,22">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource PurpleGradientBrush}">
                        <TextBlock Text="QR" FontWeight="Bold" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="KassaApp" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,20">
                    <Button Content="Back to Checkout" Style="{StaticResource SidebarNavButton}"
                            Command="{Binding BackCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button Content="Checkout" Style="{StaticResource SidebarNavButton}"
                            Command="{Binding BackCommand}" HorizontalAlignment="Stretch"/>
                    <Button Content="Products" Style="{StaticResource SidebarNavButtonActive}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,26,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Product Management" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Add, edit, and monitor stock for the catalog" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="180"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
                        <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                  AutoGenerateColumns="False" IsReadOnly="True" FontSize="13" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="140"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="80"/>
                                <DataGridTextColumn Header="Tax" Binding="{Binding Tax, StringFormat=P0}" Width="60"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding StockQty}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="1" Background="#332B1A" CornerRadius="16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Low Stock Alert" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding LowStockProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="13" Margin="0,2,0,2">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding StockQuantity, Mode=OneWay}"/>
                                            <Run Text=" left"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Product Details" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>

                            <TextBlock Text="Barcode" Style="{StaticResource MutedText}"/>
                            <TextBox Style="{StaticResource KassaTextBox}" Text="{Binding EditBarcode}" Margin="0,4,0,12"/>

                            <TextBlock Text="Name" Style="{StaticResource MutedText}"/>
                            <TextBox Style="{StaticResource KassaTextBox}" Text="{Binding EditName}" Margin="0,4,0,12"/>

                            <TextBlock Text="Price (tax included)" Style="{StaticResource MutedText}"/>
                            <TextBox Style="{StaticResource KassaTextBox}" Text="{Binding EditPrice}" Margin="0,4,0,12"/>

                            <TextBlock Text="Tax rate (e.g. 0.21 = 21%)" Style="{StaticResource MutedText}"/>
                            <TextBox Style="{StaticResource KassaTextBox}" Text="{Binding EditTax}" Margin="0,4,0,12"/>

                            <TextBlock Text="Unit Type" Style="{StaticResource MutedText}"/>
                            <ComboBox ItemsSource="{Binding UnitTypes}" SelectedItem="{Binding EditUnitType}" Margin="0,4,0,12" Padding="10,8"/>

                            <TextBlock Text="Stock Quantity" Style="{StaticResource MutedText}"/>
                            <TextBox Style="{StaticResource KassaTextBox}" Text="{Binding EditStock}" Margin="0,4,0,14"/>

                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AccentRedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <Button Content="New Product" Style="{StaticResource PosButtonSecondary}" Command="{Binding NewProductCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                            <Button Content="Save" Style="{StaticResource PosButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</UserControl>