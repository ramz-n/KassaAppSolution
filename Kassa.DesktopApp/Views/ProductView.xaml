<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Kassa.DesktopApp.Views.ProductView"
             d:DesignWidth="686.147">
    <Grid Background="AntiqueWhite">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B1F23" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Products" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                <Button Command="{Binding BackCommand}" Grid.Column="1" Content="Back" Padding="5"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                          AutoGenerateColumns="False" IsReadOnly="True" FontSize="14" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="140"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="80"/>
                        <DataGridTextColumn Header="Tax" Binding="{Binding Tax, StringFormat=P0}" Width="60"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockQty}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Background="#FFF3CD" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Low Stock Alert" FontWeight="Bold" Margin="0,0,0,6" Foreground="Red"/>
                        <ItemsControl ItemsSource="{Binding LowStockProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="Red"><Run Text="{Binding ProductName, Mode=OneWay}"/><Run Text=" "/><Run Text=" - "/><Run Text=" "/><Run Text="{Binding StockQty, Mode=OneWay}"/><Run Text=" "/><Run Text=" left"/></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Product Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="Barcode"/>
                    <TextBox Text="{Binding EditBarcode}" Margin="0,2,0,10" Padding="6"/>

                    <TextBlock Text="Name"/>
                    <TextBox Text="{Binding EditName}" Margin="0,2,0,10" Padding="6"/>

                    <TextBlock Text="Price (tax included)"/>
                    <TextBox Text="{Binding EditPrice}" Margin="0,2,0,10" Padding="6"/>

                    <TextBlock Text="Tax rate (e.g. 0.13 = 13%)"/>
                    <TextBox Text="{Binding EditTax}" Margin="0,2,0,10" Padding="6"/>

                    <TextBlock Text="Unit Type"/>
                    <ComboBox ItemsSource="{Binding UnitTypes}" SelectedItem="{Binding EditUnitType}" Margin="0,2,0,10" Padding="6"/>

                    <TextBlock Text="Stock Quantity"/>
                    <TextBox Text="{Binding EditStock}" Margin="0,2,0,10" Padding="6"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Button Content="New Product" Command="{Binding NewProductCommand}" HorizontalAlignment="Stretch" Padding="5"/>
                    <Button Content="Save" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" Padding="5"/>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>