<UserControl x:Class="Kassa.DesktopApp.Views.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:Kassa.Domain.Enums;assembly=Kassa.Domain">
    <UserControl.Resources>
        <Style x:Key="CashPanelStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="{x:Static enums:PaymentMethod.Cash}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EsewaPanelStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPaymentMethod}" Value="{x:Static enums:PaymentMethod.Esewa}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryChip" TargetType="Button" BasedOn="{StaticResource PosButtonSecondary}">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource CategoryEqualsConverter}">
                            <Binding Path="."/>
                            <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource PurpleGradientBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,24,20,22">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource PurpleGradientBrush}">
                        <TextBlock Text="QR" FontWeight="Bold" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="KassaApp" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                        Padding="14" Margin="16,0,16,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource TealGradientBrush}">
                            <TextBlock Text="&#128100;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentCashier.Name, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource MutedText}">
                                <Run Text="Register: "/>
                                <Run Text="{Binding OpenSession, Mode=OneWay, Converter={StaticResource KassaStatusConverter}}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,20">
                    <Button Content="Open Register" Style="{StaticResource SidebarNavButton}"
                            Command="{Binding OpenKassaCommand}" HorizontalAlignment="Stretch"/>
                    <Button Content="Close Register" Style="{StaticResource SidebarNavButton}"
                            Command="{Binding CloseKassaCommand}" HorizontalAlignment="Stretch"/>
                    <Button Content="Log Out" Style="{StaticResource SidebarNavButton}"
                            Command="{Binding LogoutCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button Content="Checkout" Style="{StaticResource SidebarNavButtonActive}" HorizontalAlignment="Stretch"/>
                    <Button Content="Products" Style="{StaticResource SidebarNavButton}"
                            Command="{Binding OpenProductsCommand}" HorizontalAlignment="Stretch"/>
                    <Button Content="Sales" Style="{StaticResource SidebarNavButton}"
                            Command="{Binding OpenSalesOverviewCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,26,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Checkout" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Scan a barcode or tap an item below" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBox Grid.Column="1" x:Name="BarcodeBox" Style="{StaticResource SearchBox}" VerticalAlignment="Center"
                         Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="BarcodeBox_KeyDown" Tag="Scan or search products, then press Enter"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="0,0,0,10" FontSize="13">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource AccentTealBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="18"
                Margin="0,20,20,20" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Current Sale" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding CurrentCashier.Name, Mode=OneWay}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Clear Cart" Style="{StaticResource IconButton}" Command="{Binding ClearCartCommand}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CartScannedItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                            <TextBlock FontSize="11.5" Style="{StaticResource MutedText}">
                                                <Run Text="{Binding UnitPrice, Mode=OneWay}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding UnitLabel, Mode=OneWay}"/>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="&#8722;" Style="{StaticResource StepperButton}"
                                                        Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding Quantity}" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                <Button Content="+" Style="{StaticResource StepperButton}"
                                                        Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding NetTotal, StringFormat=C}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <Button Content="&#10005;" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,10,0,0"
                                                    Command="{Binding DataContext.RemoveScannedItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Subtotal" Style="{StaticResource MutedText}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Subtotal, StringFormat=C}" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Tax" Style="{StaticResource MutedText}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding TaxTotal, StringFormat=C}" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Background="{StaticResource PurpleGradientBrush}" CornerRadius="14" Padding="16,12" Margin="0,0,0,16">
                        <Grid>
                            <TextBlock Text="Total" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GrandTotal, StringFormat=C}" FontWeight="Bold" FontSize="20" Foreground="White" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Payment Method" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Style="{StaticResource PaymentIconToggle}" GroupName="Payment"
                                     IsChecked="{Binding SelectedPaymentMethod, Converter={StaticResource PaymentMethodConverter}, ConverterParameter=Cash}">
                            <StackPanel>
                                <TextBlock Text="$" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cash" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource PaymentIconToggle}" GroupName="Payment"
                                     IsChecked="{Binding SelectedPaymentMethod, Converter={StaticResource PaymentMethodConverter}, ConverterParameter=Esewa}">
                            <StackPanel>
                                <TextBlock Text="&#9638;" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="eSewa" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Style="{StaticResource CashPanelStyle}" Margin="0,0,0,8">
                        <TextBlock Text="Amount Received" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource KassaTextBox}" Text="{Binding AmountReceived, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding ChangeDuePreview}" Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentTealBrush}"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource EsewaPanelStyle}" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <StackPanel Visibility="{Binding EsewaQrcode, Converter={StaticResource NullToVisibilityConverter}}"
                                    HorizontalAlignment="Center">
                            <Border Background="White" CornerRadius="10" Padding="8" HorizontalAlignment="Center">
                                <Image Source="{Binding EsewaQrcode}" Width="160" Height="160" SnapsToDevicePixels="True"/>
                            </Border>
                            <TextBlock Text="Scan with the eSewa app" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Generating QR code..."
                                   Visibility="{Binding EsewaQrcode, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" Margin="0,10,0,0"/>
                    </StackPanel>

                    <Button Content="Place Order" Style="{StaticResource PosButton}" FontSize="16"
                            Command="{Binding CompleteSaleCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
