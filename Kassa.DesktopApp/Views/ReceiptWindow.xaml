<Window x:Class="Kassa.DesktopApp.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt" Height="640" Width="420" WindowStartupLocation="CenterOwner"
        FontFamily="Consolas">
    <Grid Background="White" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0">
            <StackPanel x:Name="ReceiptPanel"/>
        </ScrollViewer>

        <Button Grid.Row="1" Style="{StaticResource KassaButton}" Content="Close" Margin="0,12,0,0" HorizontalAlignment="Stretch" Click="Button_Click" Padding="5"/>
    </Grid>
</Window>