<Window x:Class="Kassa.DesktopApp.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt" Height="660" Width="440" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="14" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ReceiptPanel" TextElement.FontFamily="Consolas" />
            </ScrollViewer>
        </Border>

        <Button Grid.Row="1" Content="Close" Style="{StaticResource PosButton}"
                Click="Button_Click" Margin="0,14,0,0" HorizontalAlignment="Stretch"/>
    </Grid>
</Window>