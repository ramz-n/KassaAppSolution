<UserControl x:Class="Kassa.DesktopApp.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
    <Grid Background="Black">
        <Border Background="White" Padding="200">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="QRCoders - Kassa App" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Select your name and enter your PINCODE" HorizontalAlignment="Center"/>

                <TextBlock Text="Cashier" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Cashiers}" SelectedItem="{Binding SelectedCashier}"
                          DisplayMemberPath="Name" FontSize="16" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="PINCODE" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PinBox" FontSize="20" Padding="6" PasswordChanged="PinBox_PasswordChanged" MaxLength="4"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,8,0,0"
                           HorizontalAlignment="Center" TextWrapping="Wrap"/>

                <Button Content="Log In" Margin="0,20,0,0" Padding="6"
                        Command="{Binding LoginCommand}" HorizontalAlignment="Stretch"/>

                <TextBlock Text="For example PINCode: Qaium = 1234"
                           FontSize="11" Foreground="Gray" Margin="0,16,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
